# Copy to `.env` and adjust. The Makefile and the quickstart read these.

# Postgres started by `docker compose up -d db` (see docker-compose.yml).
DATABASE_URL=postgres://coolerp:coolerp@localhost:5432/coolerp

# API bind address. Defaults to localhost — the API has NO auth yet, so do not
# expose it off-host without a trusted proxy + authentication (ADR-006).
BIND_ADDR=127.0.0.1:3000

# Optional: the agent chat endpoint (POST /chat) proxies to a local Ollama.
# The rest of the API and UI work without it.
OLLAMA_URL=http://localhost:11434
OL_CHAT_MODEL=kimi-k2.7-code:cloud
